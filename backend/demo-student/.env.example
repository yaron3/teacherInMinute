# ─── Firebase ────────────────────────────────────────────────────────────────
# Path to a service-account JSON downloaded from Firebase Console
# (Project settings → Service accounts → Generate new private key)
# Alternatively, paste the raw JSON string as the value.
FIREBASE_SERVICE_ACCOUNT=/path/to/service-account.json

# Your Realtime Database URL (found in Firebase Console → Realtime Database)
FIREBASE_DATABASE_URL=https://teacher-in-a-moment-default-rtdb.firebaseio.com

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Base URL of the local LLM server.
#   Ollama default: http://localhost:11434
#   llama.cpp server: http://localhost:8080
#   Any OpenAI-compatible proxy: http://localhost:1234
LLM_BASE_URL=http://localhost:11434

# Model name to use. Must be pulled in Ollama first: `ollama pull qwen2.5:7b`
# Smaller/faster alternatives: qwen2.5:3b, qwen3:4b
LLM_MODEL=qwen2.5:7b

# "ollama" uses /api/chat (non-streaming).
# "openai" uses /v1/chat/completions (compatible with llama.cpp, LM Studio, vLLM, etc.)
LLM_API_TYPE=ollama

# Maximum seconds to wait for the LLM before giving up.
LLM_TIMEOUT_SECONDS=60

# ─── Demo student identity ───────────────────────────────────────────────────
# UID the simulated questions and chat messages are attributed to. It does not
# have to be a real Firebase Auth user, but keeping a dedicated UID makes demo
# traffic easy to spot (and to delete) later.
DEMO_STUDENT_UID=demo-student
DEMO_STUDENT_NAME=Demo Student

# Optional avatar shown to the teacher on the invite card.
DEMO_STUDENT_IMAGE_URL=

# Minutes topped up on the demo student's balance before each simulation, so a
# demo lesson never stops on "not enough time left".
DEMO_STUDENT_MINUTES=120

# Currency used for the demo student's pricing snapshot.
DEMO_STUDENT_CURRENCY=ILS

# ─── Behaviour ───────────────────────────────────────────────────────────────
# When true, the demo student answers the teacher's chat messages using the
# local model. Set to false to only simulate the incoming question.
DEMO_STUDENT_AUTO_REPLY=true

# Pause before each student reply, so the conversation feels human-paced.
DEMO_STUDENT_REPLY_DELAY_MS=2500

# Safety valve: stop replying after this many student messages in one session.
DEMO_STUDENT_MAX_REPLIES=25

# When the local model is unreachable, fall back to a canned question per topic
# so a demo still works. Set to false to make simulations fail loudly instead.
DEMO_STUDENT_ALLOW_FALLBACK=true

# Max simultaneous simulations being generated (avoids overloading a local GPU).
MAX_CONCURRENT=2
