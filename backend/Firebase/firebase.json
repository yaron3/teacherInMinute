{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/.DS_Store",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/teacher", "destination": "/?get=teacher", "type": 302 },
      { "source": "/student", "destination": "/?get=student", "type": 302 }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      }
    ]
  },
  "remoteconfig": {
	"template": "remote_config_tim.json"
  },
  "emulators": {
    "database": { "port": 9000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
