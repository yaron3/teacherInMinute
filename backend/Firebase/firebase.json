{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/.DS_Store",
      "**/node_modules/**",
      "**/*.log"
    ],
    "predeploy": [
      "node ../../web/scripts/build-hosting.mjs"
    ],
    "rewrites": [
      { "source": "/tranzilaCheckout", "function": "tranzilaCheckout" },
      { "source": "/tranzilaCharge", "function": "tranzilaCharge" },
      { "source": "/tranzilaCheckoutStatus", "function": "tranzilaCheckoutStatus" },
      { "source": "/paypalCancel", "function": "paypalCancel" },
      { "source": "/api/status", "function": "publicLiveStatus" },
      { "source": "/app/**", "destination": "/app/index.html" }
    ],
    "redirects": [
      { "source": "/teacher", "destination": "/?get=teacher", "type": 302 },
      { "source": "/student", "destination": "/?get=student", "type": 302 },
      { "source": "/paypal/**", "destination": "/app", "type": 302 }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "regex": "^/app/[^.]*$",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/app/@(index.html|sw.js|registerSW.js|manifest.webmanifest)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/app/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  },
  "remoteconfig": {
	"template": "remote_config_tim.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "database": { "port": 9000 },
    "firestore": { "port": 8085 },
    "storage": { "port": 9199 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
