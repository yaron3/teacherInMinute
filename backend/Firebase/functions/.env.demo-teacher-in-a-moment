# Loaded only by the local emulators, which run as the demo project
# `demo-teacher-in-a-moment`. Values here override `.env`, which holds the real
# keys and would otherwise be loaded into the emulated functions too.
#
# LiveKit tokens are signed locally, so stand-in keys are enough for an accept
# to finish. Every other third-party service is blanked, so a function running
# on the emulators can never send a real email or touch a real payment account.

LIVEKIT_API_KEY=emulator-livekit-key
LIVEKIT_API_SECRET=emulator-livekit-secret-for-local-tests-only

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_VERIFY_API_KEY=
EMAIL_VERIFY_API_URL=

BRAINTREE_ENV=sandbox
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

TRANZILA_APP_KEY=
TRANZILA_SECRET=
TRANZILA_NOTIFY_KEY=
TRANZILA_TERMINAL_NAME=

ADMIN_EMAIL=
