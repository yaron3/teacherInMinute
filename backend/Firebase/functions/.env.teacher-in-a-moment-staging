# Overrides for the staging project (teacher-in-a-moment-staging).
#
# The Functions deploy loads functions/.env first and then this file, so
# anything here replaces the shared value when deploying with
# `firebase deploy --project staging`. Only project-specific addresses belong
# here; this file is committed, so no secrets.

# Callables, payment return pages and email verification links.
PUBLIC_BASE_URL=https://us-central1-teacher-in-a-moment-staging.cloudfunctions.net

# Support case links in the support emails.
SUPPORT_SITE_URL=https://teacher-in-a-moment-staging.web.app

# The Tranzila checkout page. Staging Hosting is not registered with Tranzila
# for Apple Pay, so wallets stay off here.
TRANZILA_PAGE_BASE_URL=https://teacher-in-a-moment-staging.web.app
# Apple Pay runs natively through Braintree (sandbox) here instead, since
# Tranzila's page cannot take it on this domain.
TRANZILA_WALLETS=google_pay

# PayPal: staging takes real money on the live app "Teacher In a Moment".
# The live secret is NOT here (this file is committed): staging reads
# PAYPAL_CLIENT_SECRET from the shared, git-ignored functions/.env, which must
# hold the live secret. Production overrides all four in
# .env.teacher-in-a-moment; the emulators use .env.demo-teacher-in-a-moment.
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=BAAf0uyobVVxQ7-1f4eevhAJpdecTkJIJYwULWQCkp4lIByMUS9X2Tyxz7l-8zoJvZwuVi9D4O3tFgb3GA
# Live webhook → https://us-central1-teacher-in-a-moment-staging.cloudfunctions.net/paypalWebhook
PAYPAL_WEBHOOK_ID=3AW26738MP262832D
