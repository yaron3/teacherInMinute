{
  "name": "teacher-in-moment-functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "jest",
    "test:integration:presence": "node scripts/test-teacher-presence.js",
    "test:integration:lesson": "node scripts/test-full-lesson.js",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only database --project demo-teacher-in-a-moment \"jest --config jest.emulator.config.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "braintree": "^3.39.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.5",
    "livekit-server-sdk": "^2.0.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/braintree": "^3.4.4",
    "@types/jest": "^30.0.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.4.0"
  },
  "private": true
}
