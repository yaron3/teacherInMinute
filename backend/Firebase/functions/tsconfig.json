{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017"
  },
  "compileOnSave": true,
  "include": ["src"],
  // Tests are not part of the deployed bundle, and the emulator suite
  // pulls in the Firebase client SDK, whose types the functions build
  // has no reason to check.
  "exclude": ["src/__tests__"]
}
