rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Everything below relies on one property of the app: files shared across
    // users are handed over as tokenized `downloadURL()` links, which bypass
    // these rules. Nothing needs a broad SDK-level read grant to work, so read
    // access is scoped to the owner (and, for a lesson, its two participants).

    // Profile photos are shown to the other party in a lesson. Deliberately
    // readable by any signed-in user: the images are already distributed as
    // download URLs and this keeps avatar rendering simple.
    match /profileImages/{uid}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Identity and credential documents. Owner-only; the admin console reads
    // these server-side through short-lived signed URLs (adminGetTeacherDocs),
    // never through these rules.
    match /documents/{uid}/{file=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Whiteboard snapshots for one lesson, uploaded by either participant and
    // shared into chat as a download URL. Scoped to the two people in the
    // lesson: this was previously open to every signed-in user for both read
    // and write, so anyone who knew a question id could read a lesson's board
    // or overwrite it.
    match /boardSnapshots/{questionId}/{file=**} {
      function lessonParticipant() {
        let question = firestore.get(
          /databases/(default)/documents/questions/$(questionId)
        ).data;
        // `get` with a default rather than direct field access: a question
        // that has not been accepted yet has no `acceptedByTeacher`, and
        // reading a missing key raises an error instead of returning null.
        return request.auth.uid == question.get("studentUid", "")
          || request.auth.uid == question.get("acceptedByTeacher", "");
      }
      allow read, write: if request.auth != null && lessonParticipant();
    }

    // A student's uploaded homework photos. Owner-only: invited teachers see
    // them through the download URLs stored on the question document, so they
    // never need to read this path directly.
    match /questionImages/{uid}/{file=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
