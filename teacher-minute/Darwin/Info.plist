<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<!-- Which app this is: "student" for Instant Teacher, "teacher" for Pro
		     Teacher. Each app target sets TIM_APP_ROLE; AppRole.swift reads it. -->
		<key>TIMAppRole</key>
		<string>$(TIM_APP_ROLE)</string>
		<key>FirebaseCrashlyticsCollectionEnabled</key>
		<true/>
		<key>FirebaseAutomaticScreenReportingEnabled</key>
		<false/>
		<!-- The splash's art on its gradient; see LaunchScreen.storyboard. -->
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
	<!-- The camera, microphone and photo-library purpose strings are set per
	     app target (INFOPLIST_KEY_NS*UsageDescription), since each app names
	     itself and only its own uses. -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- Google Sign-In: the REVERSED_CLIENT_ID of the app's own
		     GoogleService-Info.plist. The "Select the Firebase config" build
		     phase fails the build if the two disagree. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(TIM_GOOGLE_URL_SCHEME)</string>
			</array>
		</dict>
		<!-- The app's own scheme. Instant Teacher keeps "teacherminute", which
		     the backend's card-payment return links open; Pro Teacher takes a
		     different one so a payment return never lands in the wrong app when
		     both are installed. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(TIM_APP_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<true/>
</dict>
</plist>
