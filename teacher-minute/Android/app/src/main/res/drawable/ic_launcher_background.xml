<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background for the launcher. A shape drawable rather than a
    bitmap so it stays clean at any density and while a launcher parallaxes it.
    Angle 315 runs the gradient top-left to bottom-right, matching the iOS icon.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#1B4FBF"
        android:endColor="#0C2A6E" />
</shape>
