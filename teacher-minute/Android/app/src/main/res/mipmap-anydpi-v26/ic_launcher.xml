<?xml version="1.0" encoding="utf-8"?>
<!--
    The monochrome layer is what Android 13+ themed icons tint; without it the
    launcher keeps drawing the full-colour icon while everything around it goes
    monochrome. Older platforms ignore the tag and use background + foreground.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
