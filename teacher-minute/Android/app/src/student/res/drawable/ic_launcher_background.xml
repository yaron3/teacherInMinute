<?xml version="1.0" encoding="utf-8"?>
<!--
    Instant Teacher's adaptive-icon background. Overrides main's blue field
    with the orange one from the student app icon; the foreground and
    monochrome mipmaps beside it override main's the same way.
    Angle 315 runs the gradient top-left to bottom-right, matching the iOS icon.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FAA51E"
        android:endColor="#EC660A" />
</shape>
