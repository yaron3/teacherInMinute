<?xml version="1.0" encoding="utf-8"?>
<!--
    Instant Teacher's adaptive-icon background. Overrides main's blue field
    with the orange of the student app icon's art; the foreground and
    monochrome mipmaps beside it override main's the same way. The foreground
    already covers the whole canvas, so this only shows while a launcher
    parallaxes the layers.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E87C06" />
</shape>
